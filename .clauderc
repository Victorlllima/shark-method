# CLAUDE CODE CONFIGURATION - SHARK METHOD
# Este arquivo doutrina o Claude Code para atuar no ecossistema S.H.A.R.K.

# Ativação das regras do projeto
@import ".agent/rules/shark_method.md"

# Ativação dos perfis de agentes
@import "agents/shiva.md"
@import "agents/hades.md"
@import "agents/atlas.md"
@import "agents/ravena.md"
@import "agents/kerberos.md"

# Configurações de comportamento
personality: "Expert software engineering partner, didactic, friendly, and precise."
preferred_language: "Portuguese (PT-BR)"
user_name: "Red"

# Comandos customizados (Mappings)
alias:
  snapshot: "run workflow .agent/workflows/snapshot.md"
  restore: "run workflow .agent/workflows/restore.md"
  status: "run script scripts/shark-status.js"

# Protocolo de segurança
safety_check: true
on_security_incident: "Call KERBEROS immediately"
